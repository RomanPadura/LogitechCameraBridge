<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>LogitechCameraBridge.Wpf.App</StartupObject>
    <ApplicationIcon>Assets\LogitechCameraBridge.ico</ApplicationIcon>
    <AssemblyTitle>Logitech Camera Bridge</AssemblyTitle>
    <Product>Logitech Camera Bridge</Product>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LogitechCameraBridge.Wpf.Tests" />
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <ProjectReference Include="..\LogitechCameraBridge.Connector\LogitechCameraBridge.Connector.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\FluentCamera.svg" />
    <None Update="Assets\FluentCamera.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Keep the existing configuration as the source of truth for both hosts. -->
    <Content Include="..\LogitechCameraBridgeConsole\appSettings.json" Link="appSettings.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
